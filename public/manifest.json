{
  "id": "/?source=pwa",
  "name": "Trama App",
  "short_name": "Trama",
  "description": "Trama App: Red social privada familiar con tesoro, calendario y recuerdos compartidos",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "tabbed",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait-primary",
  "background_color": "#FAF6F0",
  "theme_color": "#E07A5F",
  "lang": "es",
  "dir": "ltr",
  "categories": [
    "social",
    "lifestyle",
    "productivity",
    "family"
  ],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "id": "app.trama.family",
      "url": "https://play.google.com/store/apps/details?id=app.trama.family"
    }
  ],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "scope_extensions": [
    {
      "origin": "*.run.app"
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "protocol_handlers": [
    {
      "protocol": "web+trama",
      "url": "/?url=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/?tab=muro&action=upload",
      "name": "Fotos y Recuerdos",
      "accept": {
        "image/*": [".jpg", ".jpeg", ".png", ".webp", ".heic"]
      }
    }
  ],
  "share_target": {
    "action": "/?share=1",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "note_taking": {
    "new_note_url": "/?tab=tesoro&new=anecdota"
  },
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "192x192 512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-mobile.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Muro y estados familiares en móvil"
    },
    {
      "src": "/screenshot-desktop.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Trama App en pantalla completa"
    },
    {
      "src": "/screenshot-mobile.svg",
      "sizes": "750x1334",
      "type": "image/svg+xml",
      "form_factor": "narrow",
      "label": "Muro familiar vector"
    },
    {
      "src": "/screenshot-desktop.svg",
      "sizes": "1280x800",
      "type": "image/svg+xml",
      "form_factor": "wide",
      "label": "Trama App vector"
    }
  ],
  "shortcuts": [
    {
      "name": "Muro Familiar",
      "short_name": "Muro",
      "description": "Ver publicaciones y momentos familiares",
      "url": "/?tab=muro",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Calendario",
      "short_name": "Calendario",
      "description": "Próximos asados y cumpleaños",
      "url": "/?tab=calendario",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Tesoro",
      "short_name": "Tesoro",
      "description": "Recetas tradicionales y anécdotas",
      "url": "/?tab=tesoro",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "widgets": [
    {
      "name": "Trama Familiar",
      "short_name": "Trama",
      "description": "Acceso rápido a recuerdos y estados familiares",
      "tag": "trama-widget",
      "template": "widget-template",
      "ms_ac_template": "widgets/trama.json",
      "data": "/widgets/data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/screenshot-mobile.png",
          "sizes": "750x1334",
          "type": "image/png",
          "label": "Widget de Trama"
        }
      ],
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
